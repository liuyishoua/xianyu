[Unit]
Description=Xianyu seller workspace
After=network.target
[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/leo-project/xianyu
ExecStart=/home/ubuntu/leo-project/xianyu/.venv/bin/python -m web --port 8770 --public-origin https://d.58nft.net:9448
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
